{
  "name": "islamic-unity",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "test:ui": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "test:resources": "node scripts/validate-resources.mjs",
    "test:quran": "node --test tests/quran-controller.test.mjs",
    "test:video": "node --test tests/video-data.test.mjs",
    "verify:quran-audio": "node scripts/verify-quran-audio.mjs",
    "preview": "npm run preview -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.56.1"
  }
}
